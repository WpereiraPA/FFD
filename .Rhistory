maquinaA <- c(4.05, 3.69, 4.10, 4.70, 4.89, 3.90, 4.00)
maquinaB <- c(3.77, 3.85, 4.07, 3.05, 2.90, 4.02, 4.50)
# 2. Execução do teste t e salvamento do objeto principal
resultado <- t.test(maquinaA, maquinaB, paired = FALSE,
var.equal = TRUE, alternative = "two.sided", conf.level = 0.95)
# 3. Extração dos valores em variáveis individuais
# (Isso fará cada uma delas virar uma LINHA no seu Environment)
t_estatistica <- resultado$statistic
p_valor       <- resultado$p.value
graus_liberdade <- resultado$parameter
media_A       <- resultado$estimate[1]
media_B       <- resultado$estimate[2]
# 4. Exibição formatada no Console com o cat()
cat("=== RESULTADOS DO TESTE T ===\n",
"Estatística t :", round(t_estatistica, 4), "\n",
"p-valor       :", round(p_valor, 4), "\n",
"Graus de Lib. :", graus_liberdade, "\n",
"Média Maq. A  :", round(media_A, 2), "\n",
"Média Maq. B  :", round(media_B, 2), "\n")
maquinaA <- c(4.05, 3.69, 4.10, 4.70, 4.89, 3.90, 4.00)
maquinaB <- c(3.77, 3.85, 4.07, 3.05, 2.90, 4.02, 4.50)
# 2. Execução do teste t e salvamento do objeto principal
resultado <- t.test(maquinaA, maquinaB, paired = FALSE,
var.equal = TRUE, alternative = "two.sided", conf.level = 0.95)
print(resultado)
# 3. Extração dos valores em variáveis individuais
# (Isso fará cada uma delas virar uma LINHA no seu Environment)
t_estatistica <- resultado$statistic
p_valor       <- resultado$p.value
graus_liberdade <- resultado$parameter
media_A       <- resultado$estimate[1]
media_B       <- resultado$estimate[2]
# 4. Exibição formatada no Console com o cat()
cat("=== RESULTADOS DO TESTE T ===\n",
"Estatística t :", round(t_estatistica, 4), "\n",
"p-valor       :", round(p_valor, 4), "\n",
"Graus de Lib. :", graus_liberdade, "\n",
"Média Maq. A  :", round(media_A, 2), "\n",
"Média Maq. B  :", round(media_B, 2), "\n")
alpha <- 0.05
if (resultado$p.value <= alpha) {
interpretacao <- paste(
"Rejeita-se a hipótese nula.",
"Há evidências de diferença estatisticamente significativa",
"entre as médias das máquinas A e B.",
"Valor de p =",
round(resultado$p.value, 4)
)
} else {
interpretacao <- paste(
"Não se rejeita a hipótese nula.",
"Não há evidências estatísticas suficientes para afirmar",
"diferença entre as médias das máquinas A e B.",
"Valor de p =",
round(resultado$p.value, 4)
)
}
cat(interpretacao)
if (resultado$p.value > 0.05) {
interpretacao <- paste(
"Aceita-se a hipótese nula de igualdade entre as médias",
"(p =", round(resultado$p.value, 4), ").",
"Não há diferença estatística significativa."
)
} else { interpretacao <- paste(
"Rejeita-se a hipótese nula.",
"Existe diferença estatística significativa entre as médias",
"(p =", round(resultado$p.value, 4), ")."
)
}
print(interpretacao)
