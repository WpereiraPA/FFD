# Instalar os pacotes (faça isso apenas uma vez, se não os tiver)
install.packages("tidyverse")
install.packages("rstatix")
# Carregar os pacotes
library(tidyverse)
library(rstatix)
# Criar o dataframe
dados <- data.frame(
Banho = factor(rep(c("Água", "Óleo A", "Óleo B"), each = 9)),
Dureza = c(
37.4, 39.7, 39.5, 39.6, 38.4, 37.9, 39.6, 38.8, 37.9, # Água
36.7, 37.1, 36.0, 37.5, 37.6, 38.3, 36.0, 36.7, 36.4, # Óleo A
36.0, 35.7, 35.0, 36.4, 35.9, 34.9, 36.2, 36.5, 36.0  # Óleo B
)
)
# 1. Rodar a ANOVA
res_anova <- dados %>% anova_test(Dureza ~ Banho)
print(res_anova)
# 2. Rodar o Teste Post-Hoc de Tukey
res_tukey <- dados %>% tukey_hsd(Dureza ~ Banho)
print(res_tukey)
resultado_tukey <- res_tukey %>%
transmute(
`Grupo 1` = group1,
`Grupo 2` = group2,
`Diferença média` = round(estimate, 3),
`Limite inferior` = round(conf.low, 3),
`Limite superior` = round(conf.high, 3),
`Valor de p ajustado` = signif(p.adj, 4),
`Significância` = p.adj.signif
)
print(resultado_tukey)
V6 <- c(39.7, 40.5, 44.0, 40.2, 42.8)
V30 <- c(38.1, 38.8, 42.3, 38.9, 43.0)
teste_t_pareado <- function(V6, V30) {
resultado <- t.test(V6, V30, paired = TRUE, conf.level = 0.95)
cat("Teste t pareado\n")
cat("Graus de liberdade (gl):", resultado$parameter, "\n")
cat("Estatística t:", round(resultado$statistic, 4), "\n")
cat("p-value:", signif(resultado$p.value, 4), "\n")
cat("Diferença média (V6 - V30):", round(resultado$estimate, 4), "\n")
cat("IC 95% para a diferença média:",
round(resultado$conf.int[1], 4), "a",
round(resultado$conf.int[2], 4), "\n")
teste_t_pareado(V6, V30)
teste_t_pareado <- function(amostra1, amostra2) {
resultado <- t.test(amostra1, amostra2, paired = TRUE)
print(resultado) }
# 1. Criação dos vetores com os dados da imagem
V6  <- c(39.7, 40.5, 44.0, 40.2, 42.8)
V30 <- c(38.1, 38.8, 42.3, 38.9, 43.0)
# 2. Execução do teste t pareado (bilateral, 95% de confiança)
resultado <- t.test(V6, V30,
paired = TRUE,           # Define que o teste é pareado
alternative = "two.sided", # Testa a hipótese de diferença != 0
conf.level = 0.95)       # Nível de confiança de 95%
# 3. Exibição do resultado completo
print(resultado)
