# Médias da resposta para cada nível dos fatores
media_A <- aggregate(Resultado ~ A, data = dados, mean)
media_B <- aggregate(Resultado ~ B, data = dados, mean)
media_C <- aggregate(Resultado ~ C, data = dados, mean)
# Organizar os três gráficos lado a lado
par(mfrow = c(1, 3))
plot(media_A$A, media_A$Resultado,
type = "b",
pch = 19,
xlab = "Fator A",
ylab = "Média da resposta",
main = "Efeito principal de A",
xaxt = "n")
axis(1, at = c(-1, 1), labels = c("-1", "+1"))
plot(media_B$B, media_B$Resultado,
type = "b",
pch = 19,
xlab = "Fator B",
ylab = "Média da resposta",
main = "Efeito principal de B",
xaxt = "n")
axis(1, at = c(-1, 1), labels = c("-1", "+1"))
plot(media_C$C, media_C$Resultado,
type = "b",
pch = 19,
xlab = "Fator C",
ylab = "Média da resposta",
main = "Efeito principal de C",
xaxt = "n")
axis(1, at = c(-1, 1), labels = c("-1", "+1"))
# Retornar ao padrão de um gráfico por vez
par(mfrow = c(1, 1))
interaction.plot(
x.factor = dados$A,
trace.factor = dados$B,
response = dados$Resultado,
xlab = "Fator A",
trace.label = "Fator B",
ylab = "Média da resposta"
)
